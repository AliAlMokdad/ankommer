/*
  # Security headers
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

  # Content Security Policy
  # Allows: self, Google Fonts, Leaflet CDN, Groq API, DAWA, Open-Meteo weather, exchange rate APIs, Rejseplanen
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://api.groq.com https://open.er-api.com https://api.dataforsyningen.dk https://api.open-meteo.com https://archive-api.open-meteo.com https://api.allorigins.win https://xmlopen.rejseplanen.dk; frame-ancestors 'none'

# Cache static assets, but allow revalidation. We bump ?v=N on script src
# tags in index.html for new releases; without this revalidation, returning
# visitors would get the old JS forever even after a deploy.
/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# Never cache HTML (always fresh)
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

# Cache manifest & sw for PWA but allow revalidation
/manifest.json
  Cache-Control: public, max-age=86400

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Cache images
/og-image.png
  Cache-Control: public, max-age=604800

/icons/*
  Cache-Control: public, max-age=31536000, immutable
